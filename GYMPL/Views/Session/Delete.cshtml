@using GYMBLL.ViewModels.SessionViewModels
@model SessionViewModel

@{
    ViewData["Title"] = "Delete Session";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">

                <div class="card-body p-5 text-center">

                    <!-- ===== WARNING ICON ===== -->
                    <div class="mb-4">
                        <i class="bi bi-exclamation-triangle-fill text-warning display-1"></i>
                    </div>

                    <!-- ===== TITLE ===== -->
                    <h3 class="text-primary-color mb-3 fw-bold">Delete Session</h3>

                    <!-- ===== WARNING ALERT ===== -->
                    <div class="alert alert-warning text-start mb-4">
                        <strong>
                            <i class="bi bi-info-circle me-2"></i>Warning:
                        </strong>
                        This action cannot be undone. All session data and bookings will be permanently deleted.
                    </div>

                    <!-- ===== SESSION SUMMARY ===== -->
                    <div class="text-start bg-light rounded p-3 mb-4">
                        <h6 class="text-muted mb-3">
                            <i class="bi bi-clipboard-check me-2"></i>Session to delete:
                        </h6>

                        <div class="mb-2">
                            <i class="bi bi-tag text-primary-color me-2"></i>
                            <strong>Category:</strong> @Model.CategoryName
                        </div>

                        <div class="mb-2">
                            <i class="bi bi-person-circle text-primary-color me-2"></i>
                            <strong>Trainer:</strong> @Model.TrainerName
                        </div>

                        <div class="mb-2">
                            <i class="bi bi-calendar3 text-primary-color me-2"></i>
                            <strong>Date:</strong> @Model.DateDisplay
                        </div>

                        <div class="mb-2">
                            <i class="bi bi-clock text-primary-color me-2"></i>
                            <strong>Time:</strong> @Model.TimeRangeDisplay
                        </div>

                        <div class="mb-0">
                            <i class="bi bi-info-circle text-primary-color me-2"></i>
                            <strong>Status:</strong>
                            @if (Model.Status == "Ongoing")
                            {
                                <span class="badge bg-success">Ongoing</span>
                            }
                            else if (Model.Status == "Upcoming")
                            {
                                <span class="badge bg-primary">Upcoming</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Completed</span>
                            }
                        </div>
                    </div>

                    <p class="text-muted mb-4">Are you sure you want to delete this session?</p>

                    <!-- ===== FORM ===== -->
                    <form asp-action="DeleteConfirm" method="post">

                        
                        <input type="hidden" name="id" value="@ViewBag.SessionId" />

                        <div class="d-flex justify-content-between gap-3">
                            <a asp-action="Index" class="btn btn-outline flex-fill">
                                <i class="bi bi-x-lg me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-danger flex-fill">
                                <i class="bi bi-trash me-1"></i>Delete
                            </button>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>