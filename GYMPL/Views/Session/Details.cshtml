@using GYMBLL.ViewModels.SessionViewModels
@model SessionViewModel

@{
    ViewData["Title"] = "Session Details";

    var headerClass = Model.Status switch
    {
        "Ongoing" => "bg-success",
        "Upcoming" => "bg-primary",
        "Completed" => "bg-secondary",
        _ => "bg-dark"
    };

    var statusIcon = Model.Status switch
    {
        "Ongoing" => "bi-play-circle-fill",
        "Upcoming" => "bi-calendar-plus-fill",
        "Completed" => "bi-check-circle-fill",
        _ => "bi-calendar-event"
    };

    var usedSlots = Model.Capacity - Model.AvailableSlots;
    var capacityPercent = Model.Capacity > 0
        ? (int)Math.Round((double)usedSlots / Model.Capacity * 100)
        : 0;

    var capacityBarClass = capacityPercent switch
    {
        >= 90 => "bg-danger",
        >= 70 => "bg-warning",
        _ => "bg-success"
    };

    var duration = Model.EndDate - Model.StartDate;
    var durationText = duration.TotalHours >= 24
        ? $"{(int)duration.TotalDays} Day(s) {duration.Hours} Hour(s)"
        : $"{duration.Hours} Hour(s) {duration.Minutes} Minute(s)";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-lg border-0 overflow-hidden">

                <!-- ===== CARD HEADER ===== -->
                <div class="card-header text-white text-center py-4 border-0 @headerClass">
                    <i class="bi @statusIcon display-4 mb-3"></i>
                    <h2 class="mb-2 fw-bold">@Model.CategoryName</h2>
                    <span class="badge bg-white text-dark fs-6 px-3 py-2">
                        @Model.Status
                    </span>
                </div>

                <!-- ===== CARD BODY ===== -->
                <div class="card-body p-4">

                    <!-- ===== DESCRIPTION ===== -->
                    <div class="mb-4 p-3 bg-light rounded">
                        <h6 class="text-primary-color mb-2">
                            <i class="bi bi-file-text me-2"></i>Description
                        </h6>
                        <p class="mb-0">@Model.Description</p>
                    </div>

                    <!-- ===== SESSION DETAILS ===== -->
                    <div class="row g-4">

                        <!-- Trainer -->
                        <div class="col-md-6">
                            <div class="detail-box p-3 border rounded h-100">
                                <div class="d-flex align-items-center">
                                    <div class="icon-box me-3">
                                        <i class="bi bi-person-circle text-primary-color fs-3"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">Trainer</small>
                                        <strong>@Model.TrainerName</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Category -->
                        <div class="col-md-6">
                            <div class="detail-box p-3 border rounded h-100">
                                <div class="d-flex align-items-center">
                                    <div class="icon-box me-3">
                                        <i class="bi bi-tag text-primary-color fs-3"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">Category</small>
                                        <strong>@Model.CategoryName</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Start Date -->
                        <div class="col-md-6">
                            <div class="detail-box p-3 border rounded h-100">
                                <div class="d-flex align-items-center">
                                    <div class="icon-box me-3">
                                        <i class="bi bi-calendar-check text-primary-color fs-3"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">Start Date & Time</small>
                                        <strong>@Model.StartDate.ToString("MMM dd, yyyy - hh:mm tt")</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- End Date -->
                        <div class="col-md-6">
                            <div class="detail-box p-3 border rounded h-100">
                                <div class="d-flex align-items-center">
                                    <div class="icon-box me-3">
                                        <i class="bi bi-calendar-x text-primary-color fs-3"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">End Date & Time</small>
                                        <strong>@Model.EndDate.ToString("MMM dd, yyyy - hh:mm tt")</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ===== CAPACITY (Full Width with Progress) ===== -->
                        <div class="col-12">
                            <div class="detail-box p-3 border rounded">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-box me-3">
                                            <i class="bi bi-people text-primary-color fs-3"></i>
                                        </div>
                                        <div>
                                            <small class="text-muted d-block">Capacity</small>
                                            <strong>
                                                @usedSlots booked / @Model.Capacity total
                                                <span class="text-muted ms-2">
                                                    (@Model.AvailableSlots spots left)
                                                </span>
                                            </strong>
                                        </div>
                                    </div>
                                    <span class="badge @capacityBarClass text-white">
                                        @capacityPercent%
                                    </span>
                                </div>

                                <!-- Progress Bar -->
                                <div class="progress mt-2" style="height: 10px;">
                                    <div class="progress-bar @capacityBarClass"
                                         role="progressbar"
                                         style="width: @capacityPercent%"
                                         aria-valuenow="@capacityPercent"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ===== DURATION (Full Width) ===== -->
                        <div class="col-12">
                            <div class="detail-box p-3 border rounded bg-light">
                                <div class="d-flex align-items-center">
                                    <div class="icon-box me-3">
                                        <i class="bi bi-hourglass-split text-primary-color fs-3"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">Duration</small>
                                        <strong class="text-primary-color fs-5">
                                            @durationText
                                        </strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- ===== CARD FOOTER ===== -->
                <div class="card-footer bg-white border-0 p-4">
                    <div class="d-flex justify-content-between gap-2 flex-wrap">

                        <a asp-action="Index" class="btn btn-outline">
                            <i class="bi bi-arrow-left me-1"></i>Back to List
                        </a>

                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@Model.Id"
                               class="btn btn-outline">
                                <i class="bi bi-pencil me-1"></i>Edit
                            </a>

                            <a asp-action="Delete" asp-route-id="@Model.Id"
                               class="btn btn-outline text-danger">
                                <i class="bi bi-trash me-1"></i>Delete
                            </a>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>