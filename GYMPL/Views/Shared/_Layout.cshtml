<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=Baloo+Thambi+2:wght@400..800&family=Rubik:ital,wght@0,300..900;1,300..900&display=swap"
        rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/style.css" />
    <title>Power Fitness | @ViewData["Title"]</title>
</head>

<body>

    <!-- ===== NAVBAR ===== -->
    <nav class="navbar navbar-expand-lg bg-white my-3">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo.jpg" alt="Logo" />
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav m-auto mb-2 mb-lg-0 mt-3 mt-lg-0">

                    <!-- ===== HOME ===== -->
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")"
                           asp-controller="Home" asp-action="Index">
                            Home
                        </a>
                    </li>

                    <!-- ===== MEMBERS ===== -->
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Member" ? "active" : "")"
                           asp-controller="Member" asp-action="Index">
                            Members
                        </a>
                    </li>

                    <!-- ===== TRAINERS ===== -->
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Trainer" ? "active" : "")"
                           asp-controller="Trainer" asp-action="Index">
                            Trainers
                        </a>
                    </li>

                    <!-- ===== SESSIONS ===== -->
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Session" ? "active" : "")"
                           asp-controller="Session" asp-action="Index">
                            Sessions
                        </a>
                    </li>

                    <!-- ===== PLANS ===== -->
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Plan" ? "active" : "")"
                           asp-controller="Plan" asp-action="Index">
                            Plans
                        </a>
                    </li>

                    <!-- ===== MEMBERSHIPS ===== -->
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Membership" ? "active" : "")"
                           asp-controller="Membership" asp-action="Index">
                            Memberships
                        </a>
                    </li>

                    <!-- ===== SCHEDULE ===== -->
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Schedule" ? "active" : "")"
                           asp-controller="Schedule" asp-action="Index">
                            Sessions Schedule
                        </a>
                    </li>

                    <!-- ===== LOGOUT ===== -->
                    <li class="nav-item">
                        <form asp-action="Logout" asp-controller="Account" method="post" class="d-inline">
                            <button type="submit"
                                    class="btn btn-link nav-link px-3 py-2 mx-2 fw-bolder fs-5 text-black-alternative">
                                Logout
                            </button>
                        </form>
                    </li>

                </ul>
            </div>
        </div>
    </nav>

    <!-- ===== MAIN CONTENT ===== -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- ===== FOOTER ===== -->
    <footer class="mt-5">
        <!-- Footer Content -->
    </footer>

    <script src="~/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>