@using GYMBLL.ViewModels.MemberSessionViewModels
@model IEnumerable<BookingViewModel>

@{
    ViewData["Title"] = "Session Members";
    var sessionId = ViewBag.SessionId;
    var sessionCategory = ViewBag.SessionCategory as string;
    var sessionDate = ViewBag.SessionDate as DateTime?;
}

<div class="container">

    <!-- ===== ALERTS ===== -->
    @if (TempData["SuccessMessage"] is not null)
    {
        <div id="Alert" class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] is not null)
    {
        <div id="Alert" class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- ===== HEADER ===== -->
    <header class="bg-primary text-white rounded-3 p-4 shadow-sm mt-5 mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h2 class="mb-1 fw-semibold">
                    <i class="bi bi-people-fill me-2"></i>Session Members
                </h2>
                <p class="mb-0 text-light opacity-75">
                    @if (!string.IsNullOrEmpty(sessionCategory))
                    {
                        <span>@sessionCategory</span>
                        @if (sessionDate.HasValue)
                        {
                            <span> — @sessionDate.Value.ToString("MMM dd, yyyy hh:mm tt")</span>
                        }
                    }
                    else
                    {
                        <span>Members that already booked this session</span>
                    }
                </p>
            </div>
            <div class="text-end">
                <a asp-action="Create" asp-route-sessionId="@sessionId" class="btn btn-light">
                    <i class="bi bi-plus-lg me-1"></i> New Booking
                </a>
            </div>
        </div>
    </header>

    <!-- ===== TABLE ===== -->
    <div class="card shadow-sm border-0">
        <div class="card-body">

            @if (Model is not null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle text-center">
                        <thead class="table-light">
                            <tr>
                                <th>Member</th>
                                <th>Phone</th>
                                <th>Booking Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var booking in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center justify-content-center gap-2">
                                            @if (!string.IsNullOrEmpty(booking.MemberPhoto))
                                            {
                                                <img src="@booking.MemberPhoto" alt="@booking.MemberName"
                                                     class="rounded-circle" width="36" height="36" />
                                            }
                                            else
                                            {
                                                <img src="~/images/User.jpg" alt="Default"
                                                     class="rounded-circle" width="36" height="36" />
                                            }
                                            <span class="fw-semibold">@booking.MemberName</span>
                                        </div>
                                    </td>
                                    <td>@booking.MemberPhone</td>
                                    <td>@booking.BookingDate.ToString("MMM dd, yyyy hh:mm tt")</td>
                                    <td>
                                        <form asp-action="Cancel"
                                              asp-route-id="@booking.Id"
                                              asp-route-sessionId="@sessionId"
                                              method="post"
                                              class="m-0 d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger"
                                                    onclick="return confirm('Are you sure you want to cancel this booking?');">
                                                <i class="bi bi-x-lg"></i> Cancel
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-person-workspace display-1 text-muted opacity-50"></i>
                    <h4 class="mt-3 text-muted">No Bookings Available</h4>
                    <p class="text-muted">Start by adding a new booking for a member</p>
                    <a asp-action="Create" asp-route-sessionId="@sessionId"
                       class="btn btn-primary mt-2">
                        <i class="bi bi-plus-lg me-1"></i> New Booking
                    </a>
                </div>
            }

        </div>
    </div>

    <!-- ===== BACK BUTTON ===== -->
    <div class="mt-4">
        <a asp-controller="SessionSchedule" asp-action="Index" class="btn btn-outline">
            <i class="bi bi-arrow-left me-1"></i> Back to Schedule
        </a>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const alerts = document.querySelectorAll(".alert");
            alerts.forEach(alert => {
                setTimeout(() => {
                    alert.style.transition = "opacity 0.5s ease";
                    alert.style.opacity = "0";
                    setTimeout(() => alert.remove(), 500);
                }, 1500);
            });
        });
    </script>
}