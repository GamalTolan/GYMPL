@model GYMBLL.ViewModels.MemberViewModels.HealthRecordViewModel

<!DOCTYPE html>

<html lang="en">

<head>

```
<meta charset="UTF-8" />

<meta name="viewport"
      content="width=device-width, initial-scale=1.0" />

<link rel="shortcut icon"
      href="~/images/icon.svg"
      type="image/x-icon" />

<link rel="preconnect"
      href="https://fonts.googleapis.com" />

<link rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin />

<link href="https://fonts.googleapis.com/css2?family=Baloo+Thambi+2:wght@400..800&family=Rubik:ital,wght@0,300..900;1,300..900&display=swap"
      rel="stylesheet" />

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

<link rel="stylesheet"
      href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<link rel="stylesheet"
      href="~/css/style.css" />

<title>Power Fitness | Health Record</title>
```

</head>

<body>

```
<header>

    <nav class="navbar navbar-expand-lg bg-white my-3">

        <div class="container">

            <a class="navbar-brand"
               asp-controller="Home"
               asp-action="Index">

                <img src="~/images/logo.jpg"
                     alt="Power Fitness Logo" />

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="navbarSupportedContent">

                <ul class="navbar-nav m-auto mb-2 mb-lg-0 mt-3 mt-lg-0">

                    <li class="nav-item">

                        <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                           asp-controller="Home"
                           asp-action="Index">

                            Home

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link active px-3 py-2 mx-2 fw-bolder fs-5"
                           asp-controller="Member"
                           asp-action="Index">

                            Members

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                           asp-controller="Trainer"
                           asp-action="Index">

                            Trainers

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                           asp-controller="Session"
                           asp-action="Index">

                            Sessions

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                           asp-controller="Plan"
                           asp-action="Index">

                            Plans

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                           asp-controller="Membership"
                           asp-action="Index">

                            Memberships

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                           asp-controller="SessionSchedule"
                           asp-action="Index">

                            Sessions Schedule

                        </a>

                    </li>

                </ul>

            </div>

        </div>

    </nav>

</header>


<div class="container">

    <main role="main" class="pb-3">

        <div class="container mt-5">

            <div class="row justify-content-center">

                <div class="col-md-8">

                    <div class="card shadow">

                        <!-- Header -->

                        <div class="card-header bg-primary-color text-white text-center py-4">

                            <i class="bi bi-heart-pulse display-5"></i>

                            <h3 class="mb-1 mt-2">
                                Health Record
                            </h3>

                            <p class="mb-0">
                                Member Health Information
                            </p>

                        </div>


                        <div class="card-body p-4">

                            <div class="row g-4">


                                <!-- Height -->

                                <div class="col-md-6">

                                    <div class="card border-0 bg-light p-4 h-100">

                                        <div class="d-flex align-items-center mb-2">

                                            <div class="bg-primary-color rounded-circle p-2 me-3"
                                                 style="width:40px;height:40px;display:flex;align-items:center;justify-content:center;">

                                                <span class="text-white fw-bold">
                                                    H
                                                </span>

                                            </div>

                                            <h6 class="text-muted mb-0">
                                                Height
                                            </h6>

                                        </div>

                                        <h4 class="text-primary-color mb-0">

                                            @Model.Hight

                                            <small>cm</small>

                                        </h4>

                                    </div>

                                </div>


                                <!-- Weight -->

                                <div class="col-md-6">

                                    <div class="card border-0 bg-light p-4 h-100">

                                        <div class="d-flex align-items-center mb-2">

                                            <div class="bg-primary-color rounded-circle p-2 me-3"
                                                 style="width:40px;height:40px;display:flex;align-items:center;justify-content:center;">

                                                <span class="text-white fw-bold">
                                                    W
                                                </span>

                                            </div>

                                            <h6 class="text-muted mb-0">
                                                Weight
                                            </h6>

                                        </div>

                                        <h4 class="text-primary-color mb-0">

                                            @Model.Weight

                                            <small>kg</small>

                                        </h4>

                                    </div>

                                </div>


                                <!-- Blood Type -->

                                <div class="col-md-6">

                                    <div class="card border-0 bg-light p-4 h-100">

                                        <div class="d-flex align-items-center mb-2">

                                            <div class="bg-danger rounded-circle p-2 me-3"
                                                 style="width:40px;height:40px;display:flex;align-items:center;justify-content:center;">

                                                <span class="text-white fw-bold">
                                                    B
                                                </span>

                                            </div>

                                            <h6 class="text-muted mb-0">
                                                Blood Type
                                            </h6>

                                        </div>

                                        <h4 class="text-danger mb-0">
                                            @Model.BloodType
                                        </h4>

                                    </div>

                                </div>


                                <!-- Note -->

                                <div class="col-md-6">

                                    <div class="card border-0 bg-light p-4 h-100">

                                        <div class="d-flex align-items-center mb-2">

                                            <div class="bg-warning rounded-circle p-2 me-3"
                                                 style="width:40px;height:40px;display:flex;align-items:center;justify-content:center;">

                                                <span class="text-white fw-bold">
                                                    N
                                                </span>

                                            </div>

                                            <h6 class="text-muted mb-0">
                                                Note
                                            </h6>

                                        </div>

                                        <h5 class="mb-0">

                                            @(string.IsNullOrWhiteSpace(Model.Note)
                                                ? "No notes available"
                                                : Model.Note)

                                        </h5>

                                    </div>

                                </div>

                            </div>


                            <!-- Footer -->

                            <div class="card-footer bg-white border-0 p-4">

                                <div class="d-flex justify-content-between gap-2">

                                    <a asp-controller="Member"
                                       asp-action="Index"
                                       class="btn btn-fill flex-fill">

                                        <i class="bi bi-arrow-left me-1"></i>

                                        Back to List

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </main>

</div>


<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
```

</body>

</html>
