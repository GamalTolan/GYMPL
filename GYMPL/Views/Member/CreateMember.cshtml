
@model GYMBLL.ViewModels.MemberViewModels.CreateMemberViewModel

@{
    ViewData["Title"] = "Create Member";
}

<div class="container mt-4">

    <header class="mb-4">
        <h3 class="text-primary-color">Add New Member</h3>
        <p class="text-muted">Create a new member profile</p>
    </header>

    <div class="row justify-content-center">
        <div class="col-md-9">

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <form asp-action="CreateMember" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>

                        <!-- ================= Personal Information ================= -->

                        <div class="section-header mb-3">
                            <h5 class="text-primary fw-bold">
                                Personal Information
                            </h5>
                            <hr class="mt-2">
                        </div>

                        <div class="row g-3 mb-4">

                            <!-- Name -->
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label">
                                    Name
                                </label>

                                <input asp-for="Name"
                                       class="form-control"
                                       placeholder="Enter member name" />

                                <span asp-validation-for="Name"
                                      class="text-danger">
                                </span>
                            </div>

                            <!-- Email -->
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label">
                                    Email
                                </label>

                                <input asp-for="Email"
                                       class="form-control"
                                       placeholder="example@gmail.com" />

                                <span asp-validation-for="Email"
                                      class="text-danger">
                                </span>
                            </div>

                            <!-- Phone -->
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label">
                                    Phone Number
                                </label>

                                <input asp-for="PhoneNumber"
                                       class="form-control"
                                       placeholder="01xxxxxxxxx" />

                                <span asp-validation-for="PhoneNumber"
                                      class="text-danger">
                                </span>
                            </div>

                            <!-- Date Of Birth -->
                            <div class="col-md-6">
                                <label asp-for="DateOfBirth" class="form-label">
                                    Date Of Birth
                                </label>

                                <input asp-for="DateOfBirth"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="DateOfBirth"
                                      class="text-danger">
                                </span>
                            </div>

                            <!-- Gender -->
                            <div class="col-md-6">
                                <label asp-for="Gender" class="form-label">
                                    Gender
                                </label>

                                <select asp-for="Gender"
                                        class="form-select">
                                    <option value="">-- Select Gender --</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>

                                <span asp-validation-for="Gender"
                                      class="text-danger">
                                </span>
                            </div>

                        </div>


                        <!-- ================= Address Information ================= -->

                        <div class="section-header mb-3">
                            <h5 class="text-primary fw-bold">
                                Address Information
                            </h5>
                            <hr class="mt-2">
                        </div>

                        <div class="row g-3 mb-4">

                            <!-- Building Number -->
                            <div class="col-md-6">
                                <label asp-for="BuildingNumber"
                                       class="form-label">
                                    Building Number
                                </label>

                                <input asp-for="BuildingNumber"
                                       type="number"
                                       class="form-control"
                                       placeholder="Building number" />

                                <span asp-validation-for="BuildingNumber"
                                      class="text-danger">
                                </span>
                            </div>

                            <!-- Street -->
                            <div class="col-md-6">
                                <label asp-for="Street"
                                       class="form-label">
                                    Street
                                </label>

                                <input asp-for="Street"
                                       class="form-control"
                                       placeholder="Street" />

                                <span asp-validation-for="Street"
                                      class="text-danger">
                                </span>
                            </div>

                            <!-- City -->
                            <div class="col-md-6">
                                <label asp-for="City"
                                       class="form-label">
                                    City
                                </label>

                                <input asp-for="City"
                                       class="form-control"
                                       placeholder="City" />

                                <span asp-validation-for="City"
                                      class="text-danger">
                                </span>
                            </div>

                        </div>


                        <!-- ================= Health Record ================= -->

                        <div class="section-header mb-3">
                            <h5 class="text-primary fw-bold">
                                Health Record
                            </h5>
                            <hr class="mt-2">
                        </div>

                        <div class="row g-3 mb-4">

                            <!-- Weight -->
                            <div class="col-md-6">
                                <label asp-for="HealthRecord.Weight"
                                       class="form-label">
                                    Weight (kg)
                                </label>

                                <input asp-for="HealthRecord.Weight"
                                       type="number"
                                       step="0.1"
                                       class="form-control"
                                       placeholder="Enter weight" />

                                <span asp-validation-for="HealthRecord.Weight"
                                      class="text-danger">
                                </span>
                            </div>

                            <!-- Height -->
                            <div class="col-md-6">
                                <label asp-for="HealthRecord.Hight"
                                       class="form-label">
                                    Height (cm)
                                </label>

                                <input asp-for="HealthRecord.Hight"
                                       type="number"
                                       step="0.1"
                                       class="form-control"
                                       placeholder="Enter height" />

                                <span asp-validation-for="HealthRecord.Hight"
                                      class="text-danger">
                                </span>
                            </div>

                            <!-- Blood Type -->
                            <div class="col-md-6">
                                <label asp-for="HealthRecord.BloodType"
                                       class="form-label">
                                    Blood Type
                                </label>

                                <input asp-for="HealthRecord.BloodType"
                                       class="form-control"
                                       placeholder="e.g. A+" />

                                <span asp-validation-for="HealthRecord.BloodType"
                                      class="text-danger">
                                </span>
                            </div>

                            <!-- Note -->
                            <div class="col-12">
                                <label asp-for="HealthRecord.Note"
                                       class="form-label">
                                    Notes
                                </label>

                                <textarea asp-for="HealthRecord.Note"
                                          class="form-control"
                                          rows="4"
                                          placeholder="Additional health notes...">
                                </textarea>

                                <span asp-validation-for="HealthRecord.Note"
                                      class="text-danger">
                                </span>
                            </div>

                        </div>


                        <!-- ================= Buttons ================= -->

                        <div class="d-flex justify-content-between mt-4 pt-3 border-top">

                            <a asp-action="Index"
                               class="btn btn-outline">
                                <i class="bi bi-arrow-left me-1"></i>
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-fill">
                                <i class="bi bi-person-plus me-1"></i>
                                Add Member
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

