@model IEnumerable<GYMBLL.ViewModels.MemberViewModels.MemberViewModel>

<div class="container">

@* Success Message *@
@if (TempData["SuccessMessage"] is not null)
{
    <div id="successAlert" class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

@* Error Message *@
@if (TempData["ErrorMessage"] is not null)
{
    <div id="errorAlert" class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

@* Page Header *@
 <header class="d-flex justify-content-between mt-5 mb-4 align-items-center">

                    <div>

                        <h2 class="text-primary-color mb-0">
                            Our Members
                        </h2>

                    </div>


                    <a asp-controller="Member"
                       asp-action="CreateMember"
                       class="btn btn-fill fw-medium rounded-pill px-4 py-3">

                        <i class="bi bi-plus-lg me-2"></i>

                        Add Member

                    </a>

                </header>


@if (Model is not null && Model.Any())
{
    <div class="table-responsive" style="overflow: visible;">
        <table class="table table-borderless">

            <thead>
                <tr>
                    <th><span>Photo</span></th>
                    <th><span>Name</span></th>
                    <th><span>Email</span></th>
                    <th><span>Gender</span></th>
                    <th><span>Phone</span></th>
                    <th><span>Action</span></th>
                </tr>
            </thead>

            <tbody>

                @foreach (var member in Model)
                {
                    <tr>

                        @* Photo *@
                        <td>
                            <span class="avatar">

                                @if (!string.IsNullOrEmpty(member.Photo))
                                {
                                    <img src="@member.Photo"
                                         alt="@member.Name"
                                         class="rounded-circle"
                                         style="width: 40px; height: 40px;" />
                                }
                                else
                                {
                                    <img src="~/images/User.png"
                                         alt="Default Avatar"
                                         class="rounded-circle"
                                         style="width: 40px; height: 40px;" />
                                }

                            </span>
                        </td>


                        @* Name *@
                        <td>
                            <span>@member.Name</span>
                        </td>


                        @* Email *@
                        <td>
                            <span>@member.Email</span>
                        </td>


                        @* Gender *@
                        <td>
                            <span>@member.Gender</span>
                        </td>


                        @* Phone *@
                        <td>
                            <span>@member.PhoneNumber</span>
                        </td>


                        @* Actions *@
                        <td class="action position-relative">

                            <div class="dropdown">

                                <button class="btn btn-link p-0 border-0"
                                        type="button"
                                        id="dropdownMenuButton-@member.Id"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">

                                    <img src="~/images/action dots.jpg"
                                         alt="Action menu" />

                                </button>


                                <ul class="dropdown-menu dropdown-menu-start"
                                    aria-labelledby="dropdownMenuButton-@member.Id">

                                    @* Member Details *@
                                    <li>
                                        <a asp-controller="Member"
                                           asp-action="MemberDetails"
                                           asp-route-id="@member.Id"
                                           class="dropdown-item d-flex align-items-center gap-3">

                                            <img src="~/images/info 1.jpg"
                                                 alt="Info"
                                                 style="width: 20px; height: 20px;" />

                                            <span>View Member Data</span>

                                        </a>
                                    </li>


                                    @* Health Record *@
                                    <li>
                                        <a asp-controller="Member"
                                           asp-action="HealthRecordDetails"
                                           asp-route-id="@member.Id"
                                           class="dropdown-item d-flex align-items-center gap-3">

                                            <img src="~/images/info 1.jpg"
                                                 alt="Health Record"
                                                 style="width: 20px; height: 20px;" />

                                            <span>View Health Record Data</span>

                                        </a>
                                    </li>


                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>


                                    @* Edit *@
                                    <li>
                                        <a asp-controller="Member"
                                           asp-action="MemberEdit"
                                           asp-route-id="@member.Id"
                                           class="dropdown-item d-flex align-items-center gap-3">

                                            <img src="~/images/edit.jpg"
                                                 alt="Edit"
                                                 style="width: 20px; height: 20px;" />

                                            <span>Edit Member Data</span>

                                        </a>
                                    </li>


                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>


                                    @* Delete *@
                                    <li>
                                        <a asp-controller="Member"
                                           asp-action="Delete"
                                           asp-route-id="@member.Id"
                                           class="dropdown-item d-flex align-items-center gap-3 text-danger">

                                            <img src="~/images/x-circle 1.jpg"
                                                 alt="Delete"
                                                 style="width: 20px; height: 20px;" />

                                            <span>Delete</span>

                                        </a>
                                    </li>

                                </ul>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>
    </div>
}
else
{
    @* Empty State *@
    <div class="text-center py-5">

        <i class="bi bi-person-workspace display-1 text-muted"></i>

        <h4 class="mt-3 text-muted">
            No Members Available
        </h4>

        <p class="text-muted">
            Add your first Member to get started
        </p>

    </div>
}


</div>

@section Scripts
{ <script>
document.addEventListener("DOMContentLoaded", function () {

        const alerts = document.querySelectorAll(".alert");

        alerts.forEach(alert => {

            setTimeout(() => {

                alert.style.transition = "opacity 0.5s ease";
                alert.style.opacity = "0";

                setTimeout(() => {
                    alert.remove();
                }, 500);

            }, 1500);

        });

    });
</script>

}
