</head>

<body>

```
<header>

    <nav class="navbar navbar-expand-lg bg-white my-3">

        <div class="container">

            <a class="navbar-brand"
               asp-controller="Home"
               asp-action="Index">

                <img src="~/images/logo.jpg"
                     alt="Power Fitness Logo" />

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="navbarSupportedContent">

                <ul class="navbar-nav m-auto mb-2 mb-lg-0 mt-3 mt-lg-0">

                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                           asp-controller="Home"
                           asp-action="Index">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link active px-3 py-2 mx-2 fw-bolder fs-5"
                           asp-controller="Member"
                           asp-action="Index">
                            Members
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                           asp-controller="Trainer"
                           asp-action="Index">
                            Trainers
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                           asp-controller="Session"
                           asp-action="Index">
                            Sessions
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                           asp-controller="Plan"
                           asp-action="Index">
                            Plans
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                           asp-controller="Membership"
                           asp-action="Index">
                            Memberships
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                           asp-controller="SessionSchedule"
                           asp-action="Index">
                            Sessions Schedule
                        </a>
                    </li>

                </ul>

            </div>

        </div>

    </nav>

</header>


<div class="container">

    <main role="main" class="pb-3">

        <div class="container mt-4">

            <header class="mb-4">

                <h3 class="text-primary-color">
                    Edit Member
                </h3>

                <p class="text-muted">
                    Update member information
                </p>

            </header>


            <div class="row justify-content-center">

                <div class="col-md-8">

                    <div class="card shadow-sm border-0">

                        <div class="card-body p-4">

                            <!-- Member Name -->
                            <div class="mb-4 pb-3 border-bottom">

                                <small class="text-muted d-block mb-1">
                                    Editing Profile For
                                </small>

                                <h4 class="mb-0 text-black">
                                    @Model.Name
                                </h4>

                            </div>


                            <form asp-controller="Member"
                                  asp-action="MemberEdit"
                                  asp-route-id="@Model.Id"
                                  method="post">

                                <!-- Important: keep the ID -->
                                <input asp-for="Id" type="hidden" />


                                <!-- Validation Summary -->
                                <div asp-validation-summary="ModelOnly"
                                     class="text-danger mb-3">
                                </div>


                                <!-- Personal Information -->

                                <div class="section-header mb-3">

                                    <h5 class="text-primary fw-bold">
                                        Personal Information
                                    </h5>

                                    <hr class="mt-2">

                                </div>


                                <div class="row g-3 mb-4">


                                    <!-- Name -->

                                    <div class="col-md-6">

                                        <label asp-for="Name"
                                               class="form-label">
                                            Name
                                        </label>

                                        <input asp-for="Name"
                                               class="form-control" />

                                        <span asp-validation-for="Name"
                                              class="text-danger">
                                        </span>

                                    </div>


                                    <!-- Email -->

                                    <div class="col-md-6">

                                        <label asp-for="Email"
                                               class="form-label">
                                            Email Address
                                        </label>

                                        <input asp-for="Email"
                                               class="form-control" />

                                        <span asp-validation-for="Email"
                                              class="text-danger">
                                        </span>

                                    </div>


                                    <!-- Phone -->

                                    <div class="col-md-6">

                                        <label asp-for="PhoneNumber"
                                               class="form-label">
                                            Phone Number
                                        </label>

                                        <input asp-for="PhoneNumber"
                                               class="form-control" />

                                        <span asp-validation-for="PhoneNumber"
                                              class="text-danger">
                                        </span>

                                    </div>


                                    <!-- Date Of Birth -->

                                    <div class="col-md-6">

                                        <label asp-for="DateOfBirth"
                                               class="form-label">
                                            Date Of Birth
                                        </label>

                                        <input asp-for="DateOfBirth"
                                               type="date"
                                               class="form-control" />

                                        <span asp-validation-for="DateOfBirth"
                                              class="text-danger">
                                        </span>

                                    </div>


                                    <!-- Gender -->

                                    <div class="col-md-6">

                                        <label asp-for="Gender"
                                               class="form-label">
                                            Gender
                                        </label>

                                        <select asp-for="Gender"
                                                class="form-select">

                                            <option value="">
                                                -- Select Gender --
                                            </option>

                                            @foreach (var gender in Enum.GetValues<GYMDAL.Entities.Enums.Gender>())
                                            {
                                                <option value="@gender">
                                                    @gender
                                                </option>
                                            }

                                        </select>

                                        <span asp-validation-for="Gender"
                                              class="text-danger">
                                        </span>

                                    </div>

                                </div>


                                <!-- Address Information -->

                                <div class="section-header mb-3">

                                    <h5 class="text-primary fw-bold">
                                        Address Information
                                    </h5>

                                    <hr class="mt-2">

                                </div>


                                <div class="row g-3 mb-4">


                                    <!-- Building Number -->

                                    <div class="col-md-6">

                                        <label asp-for="BuildingNumber"
                                               class="form-label">
                                            Building Number
                                        </label>

                                        <input asp-for="BuildingNumber"
                                               type="number"
                                               class="form-control" />

                                        <span asp-validation-for="BuildingNumber"
                                              class="text-danger">
                                        </span>

                                    </div>


                                    <!-- Street -->

                                    <div class="col-md-6">

                                        <label asp-for="Street"
                                               class="form-label">
                                            Street
                                        </label>

                                        <input asp-for="Street"
                                               class="form-control" />

                                        <span asp-validation-for="Street"
                                              class="text-danger">
                                        </span>

                                    </div>


                                    <!-- City -->

                                    <div class="col-md-6">

                                        <label asp-for="City"
                                               class="form-label">
                                            City
                                        </label>

                                        <input asp-for="City"
                                               class="form-control" />

                                        <span asp-validation-for="City"
                                              class="text-danger">
                                        </span>

                                    </div>

                                </div>


                                <!-- Health Record -->

                                <div class="section-header mb-3">

                                    <h5 class="text-primary fw-bold">
                                        Health Record
                                    </h5>

                                    <hr class="mt-2">

                                </div>


                                <div class="row g-3 mb-4">


                                    <!-- Weight -->

                                    <div class="col-md-6">

                                        <label asp-for="HealthRecord.Weight"
                                               class="form-label">
                                            Weight
                                        </label>

                                        <input asp-for="HealthRecord.Weight"
                                               type="number"
                                               step="0.01"
                                               class="form-control" />

                                        <span asp-validation-for="HealthRecord.Weight"
                                              class="text-danger">
                                        </span>

                                    </div>


                                    <!-- Height -->

                                    <div class="col-md-6">

                                        <label asp-for="HealthRecord.Hight"
                                               class="form-label">
                                            Height
                                        </label>

                                        <input asp-for="HealthRecord.Hight"
                                               type="number"
                                               step="0.01"
                                               class="form-control" />

                                        <span asp-validation-for="HealthRecord.Hight"
                                              class="text-danger">
                                        </span>

                                    </div>


                                    <!-- Blood Type -->

                                    <div class="col-md-6">

                                        <label asp-for="HealthRecord.BloodType"
                                               class="form-label">
                                            Blood Type
                                        </label>

                                        <input asp-for="HealthRecord.BloodType"
                                               class="form-control" />

                                        <span asp-validation-for="HealthRecord.BloodType"
                                              class="text-danger">
                                        </span>

                                    </div>


                                    <!-- Note -->

                                    <div class="col-12">

                                        <label asp-for="HealthRecord.Note"
                                               class="form-label">
                                            Note
                                        </label>

                                        <textarea asp-for="HealthRecord.Note"
                                                  class="form-control"
                                                  rows="3">
                                        </textarea>

                                        <span asp-validation-for="HealthRecord.Note"
                                              class="text-danger">
                                        </span>

                                    </div>

                                </div>


                                <!-- Buttons -->

                                <div class="d-flex justify-content-between mt-4 pt-3 border-top">

                                    <a asp-controller="Member"
                                       asp-action="Index"
                                       class="btn btn-outline">

                                        <i class="bi bi-arrow-left me-1"></i>
                                        Cancel

                                    </a>


                                    <button type="submit"
                                            class="btn btn-fill">

                                        <i class="bi bi-check-lg me-1"></i>
                                        Update Member

                                    </button>

                                </div>

                            </form>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </main>

</div>


<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>

<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
```

</body>

</html>
