@model GYMBLL.ViewModels.MemberViewModels.MemberViewModel

<div class="container mt-5">

```
<div class="row justify-content-center">

    <div class="col-md-6">

        <div class="card card-details border-0 p-2 shadow">

            @* Member Photo *@
            <div class="text-center mt-3">

                @if (!string.IsNullOrEmpty(Model.Photo))
                {
                    <img src="@Model.Photo"
                         alt="@Model.Name"
                         class="rounded-circle"
                         style="width: 120px;
                                height: 120px;
                                object-fit: cover;
                                border: 3px solid #fff;
                                margin-top: -60px;" />
                }
                else
                {
                    <img src="~/images/User.jpg"
                         alt="Default Avatar"
                         class="rounded-circle"
                         style="width: 120px;
                                height: 120px;
                                object-fit: cover;
                                border: 3px solid #fff;
                                margin-top: -60px;" />
                }

            </div>


            <div class="card-body text-center">

                @* Member Name *@
                <h2 class="mb-1 text-primary-color">
                    @Model.Name
                </h2>


                @* Active Plan *@
                @if (!string.IsNullOrEmpty(Model.PlanName))
                {
                    <h4 class="mb-2 pb-1 border-bottom d-block">
                        @Model.PlanName
                    </h4>
                }
                else
                {
                    <h4 class="mb-2 pb-1 border-bottom d-block text-muted">
                        No Active Plan
                    </h4>
                }


                <div class="mt-4 text-start">

                    <div class="row g-3">

                        @* Email *@
                        <div class="col-12">
                            <div class="p-3 bg-light rounded">

                                <small class="text-muted d-block mb-1">
                                    Email
                                </small>

                                <strong>
                                    @Model.Email
                                </strong>

                            </div>
                        </div>


                        @* Phone *@
                        <div class="col-12">
                            <div class="p-3 bg-light rounded">

                                <small class="text-muted d-block mb-1">
                                    Phone
                                </small>

                                <strong>
                                    @Model.PhoneNumber
                                </strong>

                            </div>
                        </div>


                        @* Gender *@
                        <div class="col-6">
                            <div class="p-3 bg-light rounded">

                                <small class="text-muted d-block mb-1">
                                    Gender
                                </small>

                                <strong>
                                    @Model.Gender
                                </strong>

                            </div>
                        </div>


                        @* Date of Birth *@
                        <div class="col-6">
                            <div class="p-3 bg-light rounded">

                                <small class="text-muted d-block mb-1">
                                    Date of Birth
                                </small>

                                <strong>
                                    @Model.DateOfBirth
                                </strong>

                            </div>
                        </div>


                        @* Membership Start Date *@
                        <div class="col-6">
                            <div class="p-3 bg-light rounded">

                                <small class="text-muted d-block mb-1">
                                    Membership Start Date
                                </small>

                                @if (!string.IsNullOrEmpty(Model.MembershipStartDate))
                                {
                                    <strong>
                                        @Model.MembershipStartDate
                                    </strong>
                                }
                                else
                                {
                                    <strong class="text-muted">
                                        N/A
                                    </strong>
                                }

                            </div>
                        </div>


                        @* Membership End Date *@
                        <div class="col-6">
                            <div class="p-3 bg-light rounded">

                                <small class="text-muted d-block mb-1">
                                    Membership End Date
                                </small>

                                @if (!string.IsNullOrEmpty(Model.MembershipEndDate))
                                {
                                    <strong>
                                        @Model.MembershipEndDate
                                    </strong>
                                }
                                else
                                {
                                    <strong class="text-muted">
                                        N/A
                                    </strong>
                                }

                            </div>
                        </div>


                        @* Address *@
                        <div class="col-12">
                            <div class="p-3 bg-light rounded">

                                <small class="text-muted d-block mb-1">
                                    Address
                                </small>

                                <strong>
                                    @Model.Address
                                </strong>

                            </div>
                        </div>

                    </div>

                </div>

            </div>


            @* Back Button *@
            <div class="d-flex justify-content-between gap-2 px-3 pb-3">

                <a asp-controller="Member"
                   asp-action="Index"
                   class="btn btn-fill flex-fill">
                    Back to List
                </a>

            </div>

        </div>

    </div>

</div>


</div>
