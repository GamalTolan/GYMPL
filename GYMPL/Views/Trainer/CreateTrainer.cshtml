
@model GYMBLL.ViewModels.TrainerViewModels.CreateTrainerViewModel

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="shortcut icon" href="~/images/icon.svg" type="image/x-icon" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Baloo+Thambi+2:wght@400..800&family=Rubik:ital,wght@0,300..900;1,300..900&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/style.css" />

    <title>Power Fitness | Add Trainer</title>
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg bg-white my-3">
            <div class="container">

                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.jpg" alt="Power Fitness Logo" />
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarSupportedContent">

                    <ul class="navbar-nav m-auto mb-2 mb-lg-0 mt-3 mt-lg-0">

                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                               asp-controller="Member"
                               asp-action="Index">
                                Members
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link active px-3 py-2 mx-2 fw-bolder fs-5"
                               asp-controller="Trainer"
                               asp-action="Index">
                                Trainers
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                               href="#">
                                Sessions
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                               href="#">
                                Plans
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                               href="#">
                                Memberships
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                               href="#">
                                Sessions Schedule
                            </a>
                        </li>

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">

        <main role="main" class="pb-3">

            <div class="container mt-4">

                <header class="mb-4">
                    <h3 class="text-primary-color">
                        Add New Trainer
                    </h3>
                </header>

                <form asp-controller="Trainer"
                      asp-action="CreateTrainer"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <!-- ================= Personal Information ================= -->

                    <div class="section-header mb-3">

                        <h5 class="text-primary fw-bold">
                            Personal Information
                        </h5>

                        <hr class="mt-2" />

                    </div>

                    <div class="row g-3">

                        <!-- Name -->
                        <div class="col-12 col-md-6">

                            <label asp-for="Name"
                                   class="form-label">
                                Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Email -->
                        <div class="col-12 col-md-6">

                            <label asp-for="Email"
                                   class="form-label">
                                Email
                            </label>

                            <input asp-for="Email"
                                   class="form-control" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Phone -->
                        <div class="col-12 col-md-6">

                            <label asp-for="PhoneNumber"
                                   class="form-label">
                                Phone Number
                            </label>

                            <input asp-for="PhoneNumber"
                                   class="form-control" />

                            <span asp-validation-for="PhoneNumber"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Date Of Birth -->
                        <div class="col-12 col-md-6">

                            <label asp-for="DateOfBirth"
                                   class="form-label">
                                Date Of Birth
                            </label>

                            <input asp-for="DateOfBirth"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="DateOfBirth"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Gender -->
                        <div class="col-12 col-md-6">

                            <label asp-for="Gender"
                                   class="form-label">
                                Gender
                            </label>

                            <select asp-for="Gender"
                                    class="form-select">

                                <option value="">
                                    -- Select Gender --
                                </option>

                                <option value="Male">
                                    Male
                                </option>

                                <option value="Female">
                                    Female
                                </option>

                            </select>

                            <span asp-validation-for="Gender"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Hire Date -->
                        <div class="col-12 col-md-6">

                            <label asp-for="HireDate"
                                   class="form-label">
                                Hire Date
                            </label>

                            <input asp-for="HireDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="HireDate"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>


                    <!-- ================= Address Information ================= -->

                    <div class="section-header mb-3 mt-4">

                        <h5 class="text-primary fw-bold">
                            Address Information
                        </h5>

                        <hr class="mt-2" />

                    </div>

                    <div class="row g-3">

                        <!-- Building Number -->
                        <div class="col-12 col-md-6">

                            <label asp-for="BuildingNumber"
                                   class="form-label">
                                Building Number
                            </label>

                            <input asp-for="BuildingNumber"
                                   type="number"
                                   class="form-control" />

                            <span asp-validation-for="BuildingNumber"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Street -->
                        <div class="col-12 col-md-6">

                            <label asp-for="Street"
                                   class="form-label">
                                Street
                            </label>

                            <input asp-for="Street"
                                   class="form-control" />

                            <span asp-validation-for="Street"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- City -->
                        <div class="col-12 col-md-6">

                            <label asp-for="City"
                                   class="form-label">
                                City
                            </label>

                            <input asp-for="City"
                                   class="form-control" />

                            <span asp-validation-for="City"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>


                    <!-- ================= Professional Information ================= -->

                    <div class="section-header mb-3 mt-4">

                        <h5 class="text-primary fw-bold">
                            Professional Information
                        </h5>

                        <hr class="mt-2" />

                    </div>

                    <div class="row g-3">

                        <div class="col-12">

                            <label class="form-label fw-semibold">
                                Specialization
                                <span class="text-danger">*</span>
                            </label>

                            <div class="form-check">

                                <input asp-for="Specialization"
                                       class="form-check-input"
                                       type="radio"
                                       value="GeneralFitness" />

                                <label class="form-check-label">
                                    General Fitness
                                </label>

                            </div>

                            <div class="form-check">

                                <input asp-for="Specialization"
                                       class="form-check-input"
                                       type="radio"
                                       value="Yoga" />

                                <label class="form-check-label">
                                    Yoga
                                </label>

                            </div>

                            <div class="form-check">

                                <input asp-for="Specialization"
                                       class="form-check-input"
                                       type="radio"
                                       value="Boxing" />

                                <label class="form-check-label">
                                    Boxing
                                </label>

                            </div>

                            <div class="form-check">

                                <input asp-for="Specialization"
                                       class="form-check-input"
                                       type="radio"
                                       value="CrossFit" />

                                <label class="form-check-label">
                                    CrossFit
                                </label>

                            </div>

                            <span asp-validation-for="Specialization"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>


                    <!-- ================= Buttons ================= -->

                    <footer class="d-flex justify-content-end mt-4">

                        <a asp-controller="Trainer"
                           asp-action="Index"
                           class="btn btn-secondary me-2">
                            Cancel
                        </a>

                        <button type="submit"
                                class="btn btn-fill">
                            Add
                        </button>

                    </footer>

                </form>

            </div>

        </main>

    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

</body>

</html>

