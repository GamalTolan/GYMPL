
@model GYMBLL.ViewModels.TrainerViewModels.CreateTrainerViewModel



<body>

    <div class="container">

        <main role="main" class="pb-3">

            <div class="container mt-4">

                <header class="mb-4">
                    <h3 class="text-primary-color">
                        Add New Trainer
                    </h3>
                </header>

                <form asp-controller="Trainer"
                      asp-action="CreateTrainer"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <!-- ================= Personal Information ================= -->

                    <div class="section-header mb-3">

                        <h5 class="text-primary fw-bold">
                            Personal Information
                        </h5>

                        <hr class="mt-2" />

                    </div>

                    <div class="row g-3">

                        <!-- Name -->
                        <div class="col-12 col-md-6">

                            <label asp-for="Name"
                                   class="form-label">
                                Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Email -->
                        <div class="col-12 col-md-6">

                            <label asp-for="Email"
                                   class="form-label">
                                Email
                            </label>

                            <input asp-for="Email"
                                   class="form-control" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Phone -->
                        <div class="col-12 col-md-6">

                            <label asp-for="PhoneNumber"
                                   class="form-label">
                                Phone Number
                            </label>

                            <input asp-for="PhoneNumber"
                                   class="form-control" />

                            <span asp-validation-for="PhoneNumber"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Date Of Birth -->
                        <div class="col-12 col-md-6">

                            <label asp-for="DateOfBirth"
                                   class="form-label">
                                Date Of Birth
                            </label>

                            <input asp-for="DateOfBirth"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="DateOfBirth"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Gender -->
                        <div class="col-12 col-md-6">

                            <label asp-for="Gender"
                                   class="form-label">
                                Gender
                            </label>

                            <select asp-for="Gender"
                                    class="form-select">

                                <option value="">
                                    -- Select Gender --
                                </option>

                                <option value="Male">
                                    Male
                                </option>

                                <option value="Female">
                                    Female
                                </option>

                            </select>

                            <span asp-validation-for="Gender"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Hire Date -->
                        <div class="col-12 col-md-6">

                            <label asp-for="HireDate"
                                   class="form-label">
                                Hire Date
                            </label>

                            <input asp-for="HireDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="HireDate"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>


                    <!-- ================= Address Information ================= -->

                    <div class="section-header mb-3 mt-4">

                        <h5 class="text-primary fw-bold">
                            Address Information
                        </h5>

                        <hr class="mt-2" />

                    </div>

                    <div class="row g-3">

                        <!-- Building Number -->
                        <div class="col-12 col-md-6">

                            <label asp-for="BuildingNumber"
                                   class="form-label">
                                Building Number
                            </label>

                            <input asp-for="BuildingNumber"
                                   type="number"
                                   class="form-control" />

                            <span asp-validation-for="BuildingNumber"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Street -->
                        <div class="col-12 col-md-6">

                            <label asp-for="Street"
                                   class="form-label">
                                Street
                            </label>

                            <input asp-for="Street"
                                   class="form-control" />

                            <span asp-validation-for="Street"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- City -->
                        <div class="col-12 col-md-6">

                            <label asp-for="City"
                                   class="form-label">
                                City
                            </label>

                            <input asp-for="City"
                                   class="form-control" />

                            <span asp-validation-for="City"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>


                    <!-- ================= Professional Information ================= -->

                    <div class="section-header mb-3 mt-4">

                        <h5 class="text-primary fw-bold">
                            Professional Information
                        </h5>

                        <hr class="mt-2" />

                    </div>

                    <div class="row g-3">

                        <div class="col-12">

                            <label class="form-label fw-semibold">
                                Specialization
                                <span class="text-danger">*</span>
                            </label>

                            <div class="form-check">

                                <input asp-for="Specialization"
                                       class="form-check-input"
                                       type="radio"
                                       value="GeneralFitness" />

                                <label class="form-check-label">
                                    General Fitness
                                </label>

                            </div>

                            <div class="form-check">

                                <input asp-for="Specialization"
                                       class="form-check-input"
                                       type="radio"
                                       value="Yoga" />

                                <label class="form-check-label">
                                    Yoga
                                </label>

                            </div>

                            <div class="form-check">

                                <input asp-for="Specialization"
                                       class="form-check-input"
                                       type="radio"
                                       value="Boxing" />

                                <label class="form-check-label">
                                    Boxing
                                </label>

                            </div>

                            <div class="form-check">

                                <input asp-for="Specialization"
                                       class="form-check-input"
                                       type="radio"
                                       value="CrossFit" />

                                <label class="form-check-label">
                                    CrossFit
                                </label>

                            </div>

                            <span asp-validation-for="Specialization"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>


                    <!-- ================= Buttons ================= -->

                    <footer class="d-flex justify-content-end mt-4">

                        <a asp-controller="Trainer"
                           asp-action="Index"
                           class="btn btn-secondary me-2">
                            Cancel
                        </a>

                        <button type="submit"
                                class="btn btn-fill">
                            Add
                        </button>

                    </footer>

                </form>

            </div>

        </main>

    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

</body>

</html>

