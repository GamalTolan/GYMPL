
@model GYMBLL.ViewModels.TrainerViewModels.TrainerViewModel

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card p-5 shadow text-center">

                <p class="fs-3 text-primary-color mb-4">
                    Are you sure you want to delete this Trainer?
                </p>

                <!-- Trainer Information -->
                <div class="mb-4">

                    @if (!string.IsNullOrEmpty(Model.Photo))
                    {
                        <img src="~/images/@Model.Photo"
                             alt="@Model.Name"
                             class="rounded-circle mb-3"
                             style="width: 100px; height: 100px; object-fit: cover;" />
                    }

                    <h4 class="mb-1">
                        @Model.Name
                    </h4>

                    <p class="text-muted mb-0">
                        @Model.Email
                    </p>

                    <p class="text-muted">
                        @Model.PhoneNumber
                    </p>

                </div>

                <!-- Warning -->
                <div class="alert alert-warning text-start" role="alert">

                    <strong>Warning!</strong>
                    This action cannot be undone.
                    All Trainer data will be permanently deleted.

                </div>

                <!-- Delete Form -->
                <form asp-controller="Trainer"
                      asp-action="DeleteTrainer"
                      method="post"
                      class="mt-4">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           asp-for="Id" />

                    <div class="buttons d-flex justify-content-between gap-3">

                        <a asp-controller="Trainer"
                           asp-action="Index"
                           class="btn-outline flex-fill">
                            NO
                        </a>

                        <button type="submit"
                                class="btn-fill flex-fill">
                            Yes
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

