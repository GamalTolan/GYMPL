
@using GYMBLL.ViewModels.TrainerViewModels
@model IEnumerable<TrainerViewModel>




 <body>

    <div class="container">

        <main role="main" class="pb-3">


            <!-- ================= Alerts ================= -->
            @if (TempData["SuccessMessage"] is not null)
            {
                <div id="SuccessAlert"
                     class="alert alert-success alert-dismissible fade show"
                     role="alert">

                    <i class="bi bi-check-circle-fill me-2"></i>

                    @TempData["SuccessMessage"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }


            @if (TempData["ErrorMessage"] is not null)
            {
                <div id="ErrorAlert"
                     class="alert alert-danger alert-dismissible fade show"
                     role="alert">

                    <i class="bi bi-exclamation-triangle-fill me-2"></i>

                    @TempData["ErrorMessage"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }


            <!-- ================= Trainers ================= -->

            <div class="container">


                <!-- Header -->

                <header class="d-flex justify-content-between mt-5 mb-4 align-items-center">

                    <div>

                        <h2 class="text-primary-color mb-0">
                            Our Trainers
                        </h2>

                        <p class="text-muted">
                            Professional fitness instructors
                        </p>

                    </div>


                    <a asp-controller="Trainer"
                       asp-action="CreateTrainer"
                       class="btn btn-fill fw-medium rounded-pill px-4 py-3">

                        <i class="bi bi-plus-lg me-2"></i>

                        Add Trainer

                    </a>

                </header>


                @if (Model is not null && Model.Any())
                {

                    <!-- ================= Trainers Table ================= -->

                    <div class="table-responsive"
                         style="overflow: visible;">

                        <table class="table table-borderless">

                            <thead>

                                <tr>

                                    <th>
                                        <span>Name</span>
                                    </th>

                                    <th>
                                        <span>Email</span>
                                    </th>

                                    <th>
                                        <span>Phone</span>
                                    </th>

                                    <th>
                                        <span>Specialization</span>
                                    </th>

                                    <th>
                                        <span>Action</span>
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var trainer in Model)
                                {

                                    <tr>

                                        <!-- Name -->

                                        <td>

                                            <span class="fw-bold">
                                                @trainer.Name
                                            </span>

                                        </td>


                                        <!-- Email -->

                                        <td>

                                            <span>
                                                @trainer.Email
                                            </span>

                                        </td>


                                        <!-- Phone -->

                                        <td>

                                            <span>
                                                @trainer.PhoneNumber
                                            </span>

                                        </td>


                                        <!-- Specialization -->

                                        <td>

                                            <span class="badge bg-primary-color">

                                                @trainer.Specialities

                                            </span>

                                        </td>


                                        <!-- Actions -->

                                        <td>
                                            <div class="dropdown">

                                                <button class="btn btn-link p-0 border-0"
                                                        type="button"
                                                        id="dropdownMenuButton-@trainer.Id"
                                                        data-bs-toggle="dropdown"
                                                        aria-expanded="false">

                                                    <img src="~/images/action dots.jpg"
                                                         alt="Action" />

                                                </button>

                                                <ul class="dropdown-menu dropdown-menu-end"
                                                    aria-labelledby="dropdownMenuButton-@trainer.Id">

                                                    <li>
                                                        <a asp-controller="Trainer"
                                                           asp-action="TrainerDetails"
                                                           asp-route-id="@trainer.Id"
                                                           class="dropdown-item">

                                                            <i class="bi bi-eye text-primary-color me-2"></i>
                                                            View Details

                                                        </a>
                                                    </li>

                                                    <li>
                                                        <hr class="dropdown-divider">
                                                    </li>

                                                    <li>
                                                        <a asp-controller="Trainer"
                                                           asp-action="TrainerEdit"
                                                           asp-route-id="@trainer.Id"
                                                           class="dropdown-item">

                                                            <i class="bi bi-pencil text-primary-color me-2"></i>
                                                            Edit Details

                                                        </a>
                                                    </li>

                                                    <li>
                                                        <hr class="dropdown-divider">
                                                    </li>

                                                    <li>
                                                        <a asp-controller="Trainer"
                                                           asp-action="Delete"
                                                           asp-route-id="@trainer.Id"
                                                           class="dropdown-item text-danger">

                                                            <i class="bi bi-trash me-2"></i>
                                                            Delete

                                                        </a>
                                                    </li>

                                                </ul>

                                            </div>
                                        </td>

                                    </tr>

                                }

                            </tbody>

                        </table>

                    </div>

                }
                else
                {

                    <!-- ================= Empty State ================= -->

                    <div class="text-center py-5">

                        <i class="bi bi-person-workspace display-1 text-muted"></i>

                        <h4 class="mt-3 text-muted">
                            No Trainers Available
                        </h4>

                        <p class="text-muted">
                            Add your first trainer to get started
                        </p>

                        <a asp-controller="Trainer"
                           asp-action="CreateTrainer"
                           class="btn btn-fill mt-2">

                            <i class="bi bi-plus-lg me-2"></i>

                            Add Trainer

                        </a>

                    </div>

                }

            </div>

        </main>

    </div>


    <!-- ================= Scripts ================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <script>
            document.addEventListener("DOMContentLoaded", function () {
                const alertBox = document.getElementById("Alert");
                if (alertBox) {
                    setTimeout(() => {
                        alertBox.style.transition = "opacity 0.5s ease";
                        alertBox.style.opacity = "0";
                        setTimeout(() => alertBox.remove(), 500);
                    }, 1500);
                }
            });
    </script>
    <script src="~/js/bootstrap.bundle.min.js"></script>

</body>

</html>

