
@using GYMBLL.ViewModels.TrainerViewModels
@model TrainerViewModel

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="shortcut icon"
          href="~/images/icon.svg"
          type="image/x-icon" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" />

    <link href="https://fonts.googleapis.com/css2?family=Baloo+Thambi+2:wght@400..800&family=Rubik:ital,wght@0,300..900;1,300..900&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/style.css" />

    <title>Power Fitness | Trainer Details</title>

</head>


<body>

    <!-- ================= Navbar ================= -->

    <header>

        <nav class="navbar navbar-expand-lg bg-white my-3">

            <div class="container">

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <img src="~/images/logo.jpg"
                         alt="Power Fitness Logo" />

                </a>


                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <div class="collapse navbar-collapse"
                     id="navbarSupportedContent">

                    <ul class="navbar-nav m-auto mb-2 mb-lg-0 mt-3 mt-lg-0">

                        <li class="nav-item">

                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                               asp-controller="Member"
                               asp-action="Index">
                                Members
                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link active px-3 py-2 mx-2 fw-bolder fs-5"
                               asp-controller="Trainer"
                               asp-action="Index">
                                Trainers
                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                               href="#">
                                Sessions
                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                               href="#">
                                Plans
                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                               href="#">
                                Memberships
                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                               href="#">
                                Sessions Schedule
                            </a>

                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <div class="container">

        <main role="main" class="pb-3">


            <div class="container mt-5">

                <div class="row justify-content-center">

                    <div class="col-md-6">

                        <div class="card shadow-lg border-0">


                            <!-- ================= Header ================= -->

                            <div class="card-header bg-primary-color text-white text-center py-5">

                                @if (!string.IsNullOrEmpty(Model.Photo))
                                {
                                    <img src="~/images/@Model.Photo"
                                         alt="@Model.Name"
                                         class="rounded-circle mb-3"
                                         style="width: 100px; height: 100px; object-fit: cover;" />
                                }
                                else
                                {
                                    <i class="bi bi-person-badge display-4 mb-3"></i>
                                }

                                <h2 class="mb-0">
                                    @Model.Name
                                </h2>

                                <span class="badge bg-light text-primary-color mt-2">
                                    @Model.Specialities Trainer
                                </span>

                            </div>


                            <!-- ================= Details ================= -->

                            <div class="card-body p-4">

                                <div class="plan-details">


                                    <!-- Email -->

                                    <div class="detail-item mb-4">

                                        <div class="d-flex align-items-center mb-2">

                                            <div class="icon-box me-3">

                                                <i class="bi bi-envelope text-primary-color fs-4"></i>

                                            </div>

                                            <div>

                                                <h6 class="mb-0 text-muted">
                                                    Email
                                                </h6>

                                                <p class="mb-0 fw-bold">
                                                    @Model.Email
                                                </p>

                                            </div>

                                        </div>

                                    </div>


                                    <!-- Phone -->

                                    <div class="detail-item mb-4">

                                        <div class="d-flex align-items-center mb-2">

                                            <div class="icon-box me-3">

                                                <i class="bi bi-telephone text-primary-color fs-4"></i>

                                            </div>

                                            <div>

                                                <h6 class="mb-0 text-muted">
                                                    Phone
                                                </h6>

                                                <p class="mb-0 fw-bold">
                                                    @Model.PhoneNumber
                                                </p>

                                            </div>

                                        </div>

                                    </div>


                                    <!-- Date Of Birth -->

                                    <div class="detail-item mb-4">

                                        <div class="d-flex align-items-center mb-2">

                                            <div class="icon-box me-3">

                                                <i class="bi bi-calendar-date text-primary-color fs-4"></i>

                                            </div>

                                            <div>

                                                <h6 class="mb-0 text-muted">
                                                    Date Of Birth
                                                </h6>

                                                <p class="mb-0 fw-bold">
                                                    @Model.DateOfBirth
                                                </p>

                                            </div>

                                        </div>

                                    </div>


                                    <!-- Gender -->

                                    <div class="detail-item mb-4">

                                        <div class="d-flex align-items-center mb-2">

                                            <div class="icon-box me-3">

                                                <i class="bi bi-gender-ambiguous text-primary-color fs-4"></i>

                                            </div>

                                            <div>

                                                <h6 class="mb-0 text-muted">
                                                    Gender
                                                </h6>

                                                <p class="mb-0 fw-bold">
                                                    @Model.Gender
                                                </p>

                                            </div>

                                        </div>

                                    </div>


                                    <!-- Address -->

                                    <div class="detail-item mb-4">

                                        <div class="d-flex align-items-center mb-2">

                                            <div class="icon-box me-3">

                                                <i class="bi bi-geo-alt text-primary-color fs-4"></i>

                                            </div>

                                            <div>

                                                <h6 class="mb-0 text-muted">
                                                    Address
                                                </h6>

                                                <p class="mb-0 fw-bold">
                                                    @Model.Address
                                                </p>

                                            </div>

                                        </div>

                                    </div>


                                    <!-- Buttons -->

                                    <div class="d-flex justify-content-between gap-2 px-3 pb-3">


                                        <a asp-controller="Trainer"
                                           asp-action="Index"
                                           class="btn btn-fill flex-fill">

                                            <i class="bi bi-arrow-left me-1"></i>

                                            Back to List

                                        </a>


                                        <a asp-controller="Trainer"
                                           asp-action="TrainerEdit"
                                           asp-route-id="@Model.Id"
                                           class="btn btn-fill flex-fill">

                                            <i class="bi bi-pencil me-1"></i>

                                            Edit

                                        </a>

                                    </div>


                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


        </main>

    </div>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>

