@model IEnumerable<GYMBLL.ViewModels.MembershipViewModels.MemberShipViewModel>

@{
    ViewData["Title"] = "Memberships";
}

<div class="container-fluid">

    <!-- ===== HEADER ===== -->
    <header class="bg-primary text-white rounded-3 p-4 shadow-sm mt-5 mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="mb-1 fw-semibold">Memberships</h2>
                <p class="mb-0 text-light opacity-75">All Memberships in the gym</p>
            </div>
            <div class="col text-end">
                <a asp-action="Create" class="btn btn-light">
                    <i class="bi bi-plus-circle"></i> New Membership
                </a>
            </div>
        </div>
    </header>

    <!-- ===== ALERTS ===== -->
    @if (TempData["SuccessMessage"] is not null)
    {
        <div id="Alert" class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] is not null)
    {
        <div id="Alert" class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- ===== TABLE ===== -->
    <div class="card">
        <div class="card-body">

            @if (Model is not null && Model.Any())
            {
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Member</th>
                            <th>Plan</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.MemberName</td>
                                <td>@item.PlanName</td>
                                <td>@item.StartDate.ToString("MMM dd, yyyy")</td>
                                <td>@item.EndDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @if (item.Status == "Active")
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Expired</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-1">

                                        @if (item.Status == "Active")
                                        {
                                           
                                        }
                                        else
                                        {
                                            <!-- ===== ACTIVATE ===== -->
                                            <form asp-action="Activate" asp-route-id="@item.Id" method="post" class="m-0">
                                                <button type="submit" class="btn btn-sm btn-success"
                                                        onclick="return confirm('Are you sure you want to activate this membership?');">
                                                    <i class="bi bi-check-circle"></i> Activate
                                                </button>
                                            </form>

                                            <!-- ===== REMOVE ===== -->
                                            <form asp-action="Remove" asp-route-id="@item.Id" method="post" class="m-0">
                                                <button type="submit" class="btn btn-sm btn-danger"
                                                        onclick="return confirm('Are you sure you want to delete this membership?');">
                                                    <i class="bi bi-trash"></i> Remove
                                                </button>
                                            </form>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <!-- ===== EMPTY STATE ===== -->
                <div class="text-center py-5">
                    <i class="bi bi-person-workspace display-1 text-muted"></i>
                    <h4 class="mt-3 text-muted">No Memberships Available</h4>
                    <p class="text-muted">Start by creating a new membership for a member</p>
                    <a asp-action="Create" class="btn btn-primary mt-2">
                        <i class="bi bi-plus-circle"></i> New Membership
                    </a>
                </div>
            }

        </div>
    </div>
</div>

@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const alerts = document.querySelectorAll(".alert");
            alerts.forEach(alert => {
                setTimeout(() => {
                    alert.style.transition = "opacity 0.5s ease";
                    alert.style.opacity = "0";
                    setTimeout(() => alert.remove(), 500);
                }, 1500);
            });
        });
    </script>
}